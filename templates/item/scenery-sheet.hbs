<section class="standard-form scrollable aa-scene-object-editor">
    <fieldset {{#unless editable}}disabled{{/unless}}>
        <legend>{{typeLabel}}</legend>
        <label class="form-group"><span class="label">Nom</span><span class="form-fields">
            <input type="text" name="name" value="{{document.name}}" required>
        </span></label>
        <label class="form-group"><span class="label">Icône dans le répertoire</span><span class="form-fields">
            <file-picker name="img" type="image" value="{{document.img}}"></file-picker>
        </span></label>
        <label class="form-group"><span class="label">Image / vidéo sur la scène</span><span class="form-fields">
            <file-picker name="system.placement.image" type="imagevideo" value="{{system.placement.image}}"></file-picker>
        </span></label>
        <p class="hint">{{#if isVisual}}Facultatif : la brume peut suffire à représenter cet effet.{{else}}Si ce champ est vide, l’icône du répertoire sera utilisée.{{/if}}</p>
        <label class="form-group stacked"><span class="label">Description</span>
            <textarea name="system.description" rows="3">{{system.description}}</textarea>
        </label>
    </fieldset>
    <fieldset {{#unless editable}}disabled{{/unless}}>
        <legend>Placement</legend>
        <label>Orientation de l’image (offset en °)<input type="number" name="system.imageAngleOffset" min="-360" max="360" step="any" value="{{system.imageAngleOffset}}"></label>
        <p class="hint">0° = vers le bas ; sens horaire positif. Compensée pour orienter une animation selon son trajet ; ignorée au dépôt.</p>
        <p class="hint">Les dimensions utilisent l’unité de distance de la scène : des mètres si la scène est graduée en mètres.</p>
        <label class="checkbox"><input type="checkbox" name="system.light.initiallyOn" {{#if system.light.initiallyOn}}checked{{/if}}> Actif au moment du dépôt</label>
        <div class="aa-scene-object-grid">
            {{#if isVisual}}
                <label>Rayon<input type="number" name="system.placement.radius" min="0.1" step="any" value="{{system.placement.radius}}" required></label>
                <label class="checkbox"><input type="checkbox" name="system.showBoundary" {{#if system.showBoundary}}checked{{/if}}> Afficher les limites de la zone</label>
            {{else}}
                <label>Largeur<input type="number" name="system.placement.width" min="0.1" step="any" value="{{system.placement.width}}" required></label>
                <label>Hauteur<input type="number" name="system.placement.height" min="0.1" step="any" value="{{system.placement.height}}" required></label>
            {{/if}}
            <label>Rotation (°)<input type="number" name="system.placement.rotation" min="0" max="360" step="any" value="{{system.placement.rotation}}" required></label>
            <label>Élévation<input type="number" name="system.placement.elevation" step="any" value="{{system.placement.elevation}}" required></label>
            <label>Opacité<input type="range" name="system.placement.opacity" min="0" max="1" step="0.05" value="{{system.placement.opacity}}"></label>
        </div>
    </fieldset>
    {{#if isVisual}}
        <fieldset {{#unless editable}}disabled{{/unless}}>
            <legend>Animation</legend>
            <p class="hint">Preset repris dans la fenêtre Animations. Vous pourrez ajuster ces valeurs pour une projection sans modifier le modèle.</p>
            <div class="aa-scene-object-grid">
                <label>Durée totale du trajet (s)<input type="number" name="system.projectileDuration" min="0.1" max="60" step="0.1" value="{{system.projectileDuration}}" required></label>
                <label>Taille initiale (% du placement)<input type="number" name="system.animation.initialSize" min="1" max="1000" step="any" value="{{animationSettings.initialSize}}" required></label>
                <label>Taille finale (% de la taille initiale)<input type="number" name="system.animation.finalSize" min="1" max="1000" step="any" value="{{animationSettings.finalSize}}" required></label>
                <label>Orientation<select name="system.animation.rotationMode"><option value="locked" {{#if (eq animationSettings.rotationMode "locked")}}selected{{/if}}>Conserver l’orientation</option><option value="direction" {{#if (eq animationSettings.rotationMode "direction")}}selected{{/if}}>Selon le trajet</option></select></label>
                <label>Offset du trajet (°)<input type="number" name="system.animation.offset" min="-3600" max="3600" step="any" value="{{animationSettings.offset}}"></label>
                <label>Rotation continue (°/s)<input type="number" name="system.animation.spin" min="-3600" max="3600" step="any" value="{{animationSettings.spin}}" required></label>
                <label>À l’arrivée<select name="system.animation.arrival">
                    <option value="keep" {{#if (eq animationSettings.arrival "keep")}}selected{{/if}}>Garder l’effet sur place</option>
                    <option value="delete" {{#if (eq animationSettings.arrival "delete")}}selected{{/if}}>Supprimer l’effet</option>
                    <option value="replace" {{#if (eq animationSettings.arrival "replace")}}selected{{/if}}>Déclencher un effet final</option>
                </select></label>
                <label>Effet de remplacement<select name="system.animation.finalEffectUuid">
                    <option value="">Choisir un effet…</option>
                    {{#each finalEffects}}<option value="{{uuid}}" {{#if (eq uuid ../animationSettings.finalEffectUuid)}}selected{{/if}}>{{name}}</option>{{/each}}
                </select></label>
                <label>Lecture de l’effet final<select name="system.animation.finalMode">
                    <option value="once-delete" {{#if (eq animationSettings.finalMode "once-delete")}}selected{{/if}}>Une lecture, puis supprimer</option>
                    <option value="once-keep" {{#if (eq animationSettings.finalMode "once-keep")}}selected{{/if}}>Une lecture, puis conserver</option>
                    <option value="loop" {{#if (eq animationSettings.finalMode "loop")}}selected{{/if}}>Lire en boucle et conserver</option>
                </select></label>
                <label>Durée finale si image ou brume (s)<input type="number" name="system.animation.finalDuration" min="0.1" max="60" step="0.1" value="{{animationSettings.finalDuration}}" required></label>
            </div>
            <p class="hint">100 % conserve la taille ; 50 % la divise par deux ; 200 % la double. Rotation : 0 pour désactiver, valeur négative pour inverser le sens. La taille et l’orientation atteintes restent à l’arrivée ; la rotation s’arrête. Pour une vidéo finale, sa durée réelle est utilisée.</p>
        </fieldset>
        <fieldset {{#unless editable}}disabled{{/unless}}>
            <legend>Brume</legend>
            <label class="checkbox"><input type="checkbox" name="system.mist.enabled" {{#if system.mist.enabled}}checked{{/if}}> Afficher une brume animée</label>
            <div class="aa-scene-object-grid">
                <label>Couleur de la brume<input type="color" name="system.mist.color" value="{{system.mist.color}}" required></label>
                <label>Densité<input type="range" name="system.mist.density" min="0" max="1" step="0.05" value="{{system.mist.density}}"></label>
                <label>Vitesse du mouvement<input type="range" name="system.mist.speed" min="0" max="5" step="0.1" value="{{system.mist.speed}}"></label>
                <label>Diffusion des bords<input type="range" name="system.mist.softness" min="0.01" max="1" step="0.01" value="{{system.mist.softness}}"></label>
                <label>Taille des volutes<input type="range" name="system.mist.scale" min="0.25" max="4" step="0.05" value="{{system.mist.scale}}"></label>
            </div>
            <p class="hint">Une nappe de brume recouvre la zone sans émettre de lumière. Sa densité masque visuellement le décor ; pour bloquer la vision, ajoutez une source d’obscurité ci-dessous.</p>
        </fieldset>
    {{/if}}
    <fieldset {{#unless editable}}disabled{{/unless}}>
        <legend>Lumière / Zone d’ombre</legend>
        <label class="checkbox"><input type="checkbox" name="system.light.enabled" {{#if system.light.enabled}}checked{{/if}}> {{#if isVisual}}Ajouter une source de lumière ou d’obscurité{{else}}Cet objet possède une source de lumière ou d’obscurité{{/if}}</label>
        <label class="checkbox"><input type="checkbox" name="system.light.negative" {{#if system.light.negative}}checked{{/if}}> Source d’obscurité (bloque lumière et vision)</label>
        <p class="hint">Les animations proposées suivent le type de source choisi. La priorité départage les sources qui se chevauchent.</p>
        <div class="aa-scene-object-grid">
            <label>Priorité de la source<input type="number" name="system.light.priority" min="0" step="1" value="{{system.light.priority}}" required></label>
            {{#unless isVisual}}
                <label>Rayon tamisé<input type="number" name="system.light.dim" min="0" step="any" value="{{system.light.dim}}" required></label>
                <label>Rayon lumineux<input type="number" name="system.light.bright" min="0" step="any" value="{{system.light.bright}}" required></label>
            {{/unless}}
            <label>Couleur<input type="color" name="system.light.color" value="{{system.light.color}}" required></label>
            <label>Intensité de couleur<input type="range" name="system.light.alpha" min="0" max="1" step="0.05" value="{{system.light.alpha}}"></label>
            <label>Luminosité<input type="range" name="system.light.luminosity" min="0" max="1" step="0.05" value="{{system.light.luminosity}}"></label>
            <label>Animation<select name="system.light.animation">
                {{#each animations}}<option value="{{key}}" {{#if (eq key ../system.light.animation)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select></label>
            <label>Vitesse<input type="range" name="system.light.speed" min="0" max="10" step="1" value="{{system.light.speed}}"></label>
            <label>Intensité de l’animation<input type="range" name="system.light.intensity" min="1" max="10" step="1" value="{{system.light.intensity}}"></label>
        </div>
        <label class="checkbox"><input type="checkbox" name="system.light.reverse" {{#if system.light.reverse}}checked{{/if}}> Inverser l’animation</label>
        <label class="checkbox"><input type="checkbox" name="system.light.walls" {{#if system.light.walls}}checked{{/if}}> Limiter le rendu par les murs</label>
        <p class="hint">Une luminosité à 0 conserve la couleur et l’animation sans rendre la zone plus lumineuse.</p>
    </fieldset>
    {{#if isInteractive}}
        <fieldset {{#unless editable}}disabled{{/unless}}>
            <legend>Actions des joueurs</legend>
            <label class="checkbox"><input type="checkbox" name="system.interaction.movable" {{#if system.interaction.movable}}checked{{/if}}> Autoriser le déplacement et la rotation</label>
            <label class="checkbox"><input type="checkbox" name="system.interaction.toggleLight" {{#if system.interaction.toggleLight}}checked{{/if}}> Autoriser l’allumage / extinction</label>
            <label class="form-group stacked"><span class="label">Interactions</span><textarea name="system.interactions" rows="3">{{system.interactions}}</textarea></label>
        </fieldset>
    {{/if}}
    {{#if editable}}
        <footer class="form-footer">
            {{#if canPlace}}<button type="button" data-action="placeSceneObject">Enregistrer et placer sur la scène</button>{{/if}}
            <button type="submit"><i class="fa-solid fa-save" aria-hidden="true"></i> Enregistrer</button>
        </footer>
    {{/if}}
</section>
