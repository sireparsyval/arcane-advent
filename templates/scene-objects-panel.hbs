{{#*inline "animationEntry"}}
    <article class="aa-animation-entry">
        <img src="{{img}}" alt="">
        <div class="aa-animation-entry-text"><strong>{{name}}</strong><small>{{path}}</small>{{#if status}}<small>{{status}}</small>{{/if}}</div>
        <div class="aa-animation-entry-actions">
            <button type="button" data-action="launch" data-uuid="{{uuid}}" data-tile-id="{{id}}" title="Tracer et lancer les préréglages" aria-label="Lancer {{name}}" {{#if moving}}disabled{{/if}}>▶</button>
            <button type="button" data-action="prepare" data-uuid="{{uuid}}" data-tile-id="{{id}}" title="Préparer puis tracer et lancer" aria-label="Préparer {{name}}" {{#if moving}}disabled{{/if}}>✎</button>
            <button type="button" data-action="model" data-uuid="{{uuid}}" data-tile-id="{{id}}" title="Paramètres de l’effet" aria-label="Paramètres de {{name}}">⚙</button>
            {{#if id}}<button type="button" data-action="interact" data-tile-id="{{id}}" title="Impact, suppression et interactions" aria-label="Interagir avec {{name}}">⋯</button>{{/if}}
        </div>
    </article>
{{/inline}}
<section class="aa-scene-objects-body">
    <p>{{#if sceneName}}Scène : <strong>{{sceneName}}</strong>{{else}}Ouvrez une scène pour préparer une animation.{{/if}}</p>
    {{#if isGM}}
        <div class="aa-animation-columns">
            <section><header><h3>Effets du répertoire</h3><button type="button" data-action="createModel" title="Créer un Effet Visuel">+</button></header>
                <div class="aa-scene-objects-list">{{#each models}}{{> animationEntry}}{{else}}<p>Aucun Effet Visuel dans le répertoire.</p>{{/each}}</div>
            </section>
            <section><header><h3>Effets sur la scène</h3></header>
                <div class="aa-scene-objects-list">{{#each effects}}{{> animationEntry}}{{else}}<p>Aucun effet présent sur cette scène.</p>{{/each}}</div>
            </section>
        </div>
        <footer class="aa-object-motion-footer"><button type="button" data-action="moveObject">Animer un token ou un objet</button>{{{motionFields}}}</footer>
    {{else}}
        <div class="aa-scene-objects-list">
        {{#each objects}}
            <article class="aa-scene-object-row">
                <img src="{{img}}" alt="">
                <div><strong>{{name}}</strong><small>{{type}}{{#if status}} · {{status}}{{/if}}</small></div>
                <button type="button" data-action="interact" data-tile-id="{{id}}">Interagir</button>
            </article>
        {{else}}<p>Aucun effet ou objet accessible sur cette scène.</p>{{/each}}
    </div>
    {{/if}}
</section>
