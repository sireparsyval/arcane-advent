<div class="aa-condition-form standard-form">
    <label>
        Nom du bouton
        <input type="text" name="name" value="{{current.name}}" required pattern=".*\S.*" autofocus>
    </label>

    <label>
        Formule
        <input type="text" name="formula" value="{{current.formula}}" placeholder="1d20" required>
    </label>

    <fieldset class="aa-aptitude-ability-choices">
        <legend>Caractéristiques à ajouter (plusieurs possibles)</legend>
        {{#each abilities}}
            <label class="checkbox">
                <input type="checkbox" name="abilities" value="{{key}}" {{#if selected}}checked{{/if}}>
                {{label}}
            </label>
        {{/each}}
    </fieldset>

    <label>
        Compétence (bonus de maîtrise)
        <select name="skillId">
            <option value="">Aucune</option>
            {{#each skills}}
                <option value="{{id}}" {{#if (eq id ../current.skillId)}}selected{{/if}}>{{name}}</option>
            {{/each}}
        </select>
    </label>

    <label>
        Expertise
        <select name="expertiseId">
            <option value="">Aucune</option>
            {{#each expertises}}
                <option value="{{id}}" {{#if (eq id ../current.expertiseId)}}selected{{/if}}>
                    {{name}}{{#if system.target}} · {{system.target}}{{/if}} ({{system.bonus}})
                </option>
            {{/each}}
        </select>
    </label>
    <p class="hint">Une expertise liée à l’équipement s’applique si un objet correspondant est équipé au moment du jet.</p>
</div>
