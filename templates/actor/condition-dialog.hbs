<div class="aa-condition-form standard-form">
    <label>
        Nom
        <input type="text" name="name" value="{{name}}" required pattern=".*\S.*" autofocus>
    </label>

    {{#if zones}}
        <label>
            Zone blessée
            <select name="zone">
                {{#each zones}}
                    <option value="{{@key}}" {{#if (eq @key ../system.zone)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </label>
    {{/if}}

    {{#if durationUnits}}
        <fieldset class="aa-alteration-duration">
            <legend>Durée de l'altération</legend>
            <label>
                <input type="checkbox" name="durationEnabled" {{#if system.duration.enabled}}checked{{/if}}>
                Durée limitée
            </label>
            <label>
                Durée restante
                <input type="number" name="durationRemaining" value="{{system.duration.remaining}}" min="0" step="1" required>
            </label>
            <label>
                Unité
                <select name="durationUnit">
                    {{#each durationUnits}}
                        <option value="{{@key}}" {{#if (eq @key ../system.duration.unit)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </label>
        </fieldset>
    {{/if}}

    <details class="aa-condition-modifier-details" open>
        <summary>Bonus / malus appliqués</summary>
        <p class="hint">Ces valeurs s'ajoutent automatiquement aux autres sources. Laissez 0 si la condition ne modifie pas cette valeur.</p>
        {{#each modifierGroups}}
            <fieldset class="aa-condition-modifier-group">
                <legend>{{title}}</legend>
                <div class="aa-modifier-edit-grid">
                    {{#each fields}}
                        <label class="aa-modifier-edit-line">
                            <span>{{label}}</span>
                            <input type="number" name="modifier.{{key}}" value="{{value}}"
                                step="{{step}}" required aria-label="Bonus/malus : {{label}}">
                        </label>
                    {{/each}}
                </div>
            </fieldset>
        {{/each}}
    </details>

    <label>
        Description
        <textarea name="description" rows="4">{{system.description}}</textarea>
    </label>
</div>
