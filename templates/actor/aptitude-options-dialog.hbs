<section class="aa-editor-form aa-aptitude-options-editor standard-form">
    <p class="hint">Les paramètres décrivent l'Aptitude et ses contraintes. Aucun jet n'est bloqué automatiquement.</p>
    <fieldset>
        <legend>Contraintes</legend>
        {{#if isTechnique}}
            <p class="hint">Les Techniques n'utilisent pas de charges, de délai de récupération ni de temps d'incantation.</p>
        {{else}}
            <label class="checkbox"><input type="checkbox" name="enable.charge" {{#if chargeActive}}checked{{/if}}> Charges multiples</label>
            <div class="aa-aptitude-options-inline">
                <label>Restantes<input type="number" name="charge.remaining" min="0" step="1" value="{{system.chargeCounter.remaining}}"></label>
                <label>Max<input type="number" name="charge.max" min="0" step="1" value="{{system.chargeCounter.max}}"></label>
            </div>
            <label class="checkbox"><input type="checkbox" name="enable.recovery" {{#if recoveryActive}}checked{{/if}}> Délai de récupération</label>
            <div class="aa-aptitude-options-inline">
                <label>Restant<input type="number" name="recovery.remaining" min="0" step="1" value="{{system.recoveryCounter.remaining}}"></label>
                <label>Max<input type="number" name="recovery.max" min="0" step="1" value="{{system.recoveryCounter.max}}"></label>
                <label>Unité<select name="recovery.unit">
                    {{#each units}}<option value="{{key}}" {{#if (eq key ../system.recoveryCounter.unit)}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></label>
            </div>
            <label class="checkbox"><input type="checkbox" name="enable.casting" {{#if castingActive}}checked{{/if}}> Temps d'incantation</label>
            <div class="aa-aptitude-options-inline">
                <label>Progression<input type="number" name="casting.remaining" min="0" step="1" value="{{system.castingCounter.remaining}}"></label>
                <label>Max<input type="number" name="casting.max" min="0" step="1" value="{{system.castingCounter.max}}"></label>
                <label>Unité<select name="casting.unit">
                    {{#each units}}<option value="{{key}}" {{#if (eq key ../system.castingCounter.unit)}}selected{{/if}}>{{label}}</option>{{/each}}
                </select></label>
            </div>
        {{/if}}
    </fieldset>

    <fieldset>
        <legend>Conditions individuelles</legend>
        <div class="aa-condition-chips">
            {{#each conditions}}
                <button type="button" class="aa-condition-chip" data-aa-edit-condition="{{id}}" title="Modifier {{label}}">
                    {{#if automatic}}⚙{{else}}☑{{/if}} {{label}}
                </button>
            {{else}}
                <p class="hint">Aucune condition.</p>
            {{/each}}
        </div>
        <div class="aa-aptitude-options-inline">
            <button type="button" data-aa-add-condition="manual">+ Toggle manuel</button>
            <button type="button" data-aa-add-condition="automatic">+ Condition automatique</button>
        </div>
        <label>Notes de conditions (facultatif)
            <textarea name="requirements" rows="2">{{system.requirements}}</textarea>
        </label>
    </fieldset>

    <fieldset>
        <legend>Effets et ciblage</legend>
        <label class="checkbox"><input type="checkbox" name="effect.enabled" {{#if durationActive}}checked{{/if}}>
            Durée des effets</label>
        <div class="aa-aptitude-options-inline">
            <label>Restant<input type="number" name="effect.remaining" min="0" step="1" value="{{effectRemaining}}"></label>
            <label>Unité<select name="effect.unit">
                {{#each units}}<option value="{{key}}" {{#if (eq key ../effectUnit)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select></label>
        </div>

        <div class="aa-aptitude-options-grid">
            <label>Ciblage<select name="target.mode">
                {{#each targetModes}}<option value="{{key}}" {{#if (eq key ../system.targeting.mode)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select></label>
            <label>Nombre maximal de cibles<input name="target.maxTargets" type="number" min="0" step="1" value="{{system.targeting.maxTargets}}"></label>
            <label>Portée (m)<input name="target.range" type="number" min="0" step="any" value="{{system.targeting.range}}"></label>
            <label>Forme de zone<select name="target.shape">
                {{#each shapes}}<option value="{{key}}" {{#if (eq key ../system.targeting.shape)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select></label>
            <label>Rayon (m)<input name="target.radius" type="number" min="0" step="any" value="{{system.targeting.radius}}"></label>
            <label>Longueur (m)<input name="target.length" type="number" min="0" step="any" value="{{system.targeting.length}}"></label>
            <label>Largeur (m)<input name="target.width" type="number" min="0" step="any" value="{{system.targeting.width}}"></label>
            <label>Angle (degrés)<input name="target.angle" type="number" min="0" max="360" step="any" value="{{system.targeting.angle}}"></label>
            <label>Origine de l'effet<select name="target.origin">
                {{#each origins}}<option value="{{key}}" {{#if (eq key ../system.targeting.origin)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select></label>
            <label>Propagation<select name="target.propagation">
                {{#each propagations}}<option value="{{key}}" {{#if (eq key ../system.targeting.propagation)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select></label>
        </div>
        <label class="checkbox"><input name="target.travels" type="checkbox" {{#if system.targeting.travels}}checked{{/if}}>
            Le trajet depuis le lanceur jusqu'à la cible est parcouru / affecté</label>
        <p class="hint">Formes et distances sont descriptives : placement et résolution restent manuels.</p>
    </fieldset>

    <fieldset>
        <legend>Créateur de jets</legend>
        <p class="hint">Créez plusieurs jets personnalisés, avec caractéristiques, Compétence et Expertise associées.</p>
        <button type="button" data-aa-add-roll>+ Ajouter un jet 🎲</button>
    </fieldset>
</section>