<section class="aa-panel aa-traits-panel">
    <div class="aa-condition-heading aa-aptitude-heading">
        <h2 class="aa-status-title"><span class="aa-heading-icon" aria-hidden="true">🧬</span>Traits</h2>
        {{#if canEditState}}
            <button type="button" data-action="addTrait" aria-label="Ajouter un Trait" title="Ajouter un Trait">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
            </button>
        {{/if}}
    </div>

    {{#each traits}}
        <div class="aa-trait-row" data-trait-row="{{id}}" data-sheet-sort-drop="{{id}}">
            <div class="aa-trait-identity">
                {{#if @root.canEditState}}
                    <span class="aa-sort-handle" draggable="true" data-sheet-sort-drag="{{id}}"
                        aria-label="Réordonner {{name}}" title="Glisser pour réordonner">⠿</span>
                    <input class="aa-trait-name" type="text" value="{{name}}" required pattern=".*\S.*"
                        data-trait-field="name" data-trait-id="{{id}}" aria-label="Nom du Trait">
                    <div class="aa-trait-actions">
                        <button type="button" data-action="editCharacterEffects" data-item-id="{{id}}"
                            aria-label="Configurer {{name}}" title="Description, effets et conditions du Trait">
                            <i class="fa-solid fa-gear" aria-hidden="true"></i>
                        </button>
                        <button type="button" data-action="toggleTraitConfig" aria-expanded="{{configOpen}}" title="Aptitudes liées">↳ Aptitudes</button>
                        <button type="button" data-action="deleteTrait" data-trait-id="{{id}}"
                            aria-label="Retirer {{name}}" title="Retirer le Trait">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                {{else}}
                    <strong>{{name}}</strong>
                {{/if}}
            </div>

            {{#if system.requirements}}
                <div class="aa-requirements-note"><strong>Conditions requises :</strong> {{system.requirements}}</div>
            {{/if}}
            {{#if effectCount}}
                <div class="aa-effect-source-line"><span>{{effectCount}} effet(s) · {{#if effectActive}}Actifs{{else}}Inactifs{{/if}}</span>
                {{#if effectManual}}<button type="button" data-action="toggleCharacterEffects" data-item-id="{{id}}" aria-pressed="{{system.effectActivation.active}}" {{#unless @root.canEditState}}disabled{{/unless}}>Activer / désactiver</button>{{/if}}</div>
            {{/if}}

            {{#if @root.canEditState}}
                <div class="aa-trait-config" data-trait-config="{{id}}" {{#unless configOpen}}hidden{{/unless}}>
                    <label class="aa-trait-requirements-editor">
                        <span>Conditions requises (facultatives)</span>
                        <textarea rows="2" data-trait-field="requirements" data-trait-id="{{id}}"
                            placeholder="Circonstances dans lesquelles ce Trait s'applique…">{{system.requirements}}</textarea>
                    </label>
                    <div class="aa-trait-links-heading">
                        <strong>Aptitudes liées</strong>
                        <button type="button" data-action="createLinkedAptitude" data-trait-id="{{id}}"
                            title="Créer une aptitude associée à ce Trait">+ Aptitude</button>
                    </div>
                    <div class="aa-trait-links">
                        {{#each linkedAptitudes}}
                            <div class="aa-trait-link-row">
                                <span>{{name}} <small>· {{categoryLabel}}</small></span>
                                <button type="button" data-action="deleteLinkedAptitude"
                                    data-trait-id="{{../id}}" data-item-id="{{id}}"
                                    aria-label="Supprimer l'aptitude {{name}}" title="Supprimer cette aptitude liée">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        {{else}}
                            <small>Aucune Aptitude liée à ce Trait.</small>
                        {{/each}}
                    </div>
                </div>
            {{/if}}

            <details data-trait-description="{{id}}" {{#if descriptionOpen}}open{{/if}}>
                <summary>Exceptions et particularités</summary>
                {{#if @root.canEditState}}
                    <textarea rows="4" data-trait-field="description" data-trait-id="{{id}}"
                        aria-label="Description et exceptions de {{name}}"
                        placeholder="Particularités, exceptions aux règles et effets du Trait…">{{system.description}}</textarea>
                {{else}}
                    <p>{{#if system.description}}{{system.description}}{{else}}Aucune description.{{/if}}</p>
                {{/if}}
            </details>
        </div>
    {{else}}
        <p class="aa-condition-empty">Aucun Trait.</p>
    {{/each}}
</section>
