                        {{else}}
                            <p class="aa-empty-equipment">Aucun bouclier équipé.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">🥋</span>Protections équipées</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.protections}}
                            <div class="aa-equipment-card" data-sheet-sort-drop="{{id}}">
                                <div class="aa-equipment-identity">
                                    {{#if @root.canEditState}}<span class="aa-sort-handle" draggable="true" data-sheet-sort-drag="{{id}}" aria-label="Réordonner {{name}}" title="Glisser pour réordonner">⠿</span>{{/if}}
                                    <label class="aa-equipment-field">
                                        <span>Nom</span>
                                        <input type="text" value="{{name}}"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                    </label>
                                    <label class="aa-equipment-field">
                                        <span>Classe</span>
                                        <input type="text" value="{{system.armorClass}}" placeholder="Plaque"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="system.armorClass">
                                    </label>
                                    <div class="aa-protection-controls">
                                        <label class="aa-equipment-inline">
                                            <span>DEF</span>
                                            <input type="number" value="{{system.defenseBonus}}"
                                                data-equipment-edit data-item-id="{{id}}" data-item-field="system.defenseBonus">
                                        </label>
                                        {{> equippedInventoryControls}}
                                    </div>
                                </div>

                                <div class="aa-equipment-detail">
                                    <strong class="aa-equipment-label">Zones</strong>
                                    <div class="aa-equipment-options">
                                        <button type="button" aria-pressed="{{#if zones.head}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="head">Tête</button>
                                        <button type="button" aria-pressed="{{#if zones.torso}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="torso">Torse</button>
                                        <button type="button" aria-pressed="{{#if zones.arms}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="arms">Bras</button>
                                        <button type="button" aria-pressed="{{#if zones.legs}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="legs">Jambes</button>
                                    </div>
                                </div>

                                {{> damageReductionControls}}
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Aucune protection équipée.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">💍</span>Accessoires équipés</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.accessories}}
                            <div class="aa-equipment-row" data-sheet-sort-drop="{{id}}">
                                {{#if @root.canEditState}}<span class="aa-sort-handle" draggable="true" data-sheet-sort-drag="{{id}}" aria-label="Réordonner {{name}}" title="Glisser pour réordonner">⠿</span>{{/if}}
                                <input type="text" value="{{name}}" aria-label="Nom de l'accessoire"
                                    data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                {{> equippedInventoryControls unequipText="Déséquiper"}}
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Aucun accessoire équipé.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <header class="aa-inventory-heading">
                        <h3><span class="aa-heading-icon" aria-hidden="true">📦</span>Inventaire</h3>
                        <strong class="aa-inventory-weight" title="Équipement porté inclus">Charge totale · {{inventory.totalLabel}}</strong>
                        <button type="button" data-action="toggleInventoryWeights" aria-label="Afficher tous les poids"
                            aria-pressed="{{inventory.showWeights}}"
                            title="Affichage des poids · {{#if inventory.showWeights}}Tous les poids{{else}}Contenants seuls{{/if}}">
                            <span aria-hidden="true">⚖️</span>
                        </button>
                        {{#if canEditState}}
                            <div class="aa-equipment-create">
                                <button type="button" data-action="addInventoryItem" data-inventory-type="object"
                                    aria-label="Ajouter un objet" title="Ajouter un objet"><span aria-hidden="true">+💎</span></button>
                                <button type="button" data-action="addInventoryItem" data-inventory-type="purse"
                                    aria-label="Ajouter une bourse" title="Ajouter une bourse"><span aria-hidden="true">+💰</span></button>
                                <button type="button" data-action="addInventoryItem" data-inventory-type="container"
                                    aria-label="Ajouter un contenant" title="Ajouter un contenant"><span aria-hidden="true">+🪎</span></button>
                            </div>
                        {{/if}}
                    </header>

                    {{#if inventory.rows.length}}
                        <ul class="aa-inventory-tree" aria-label="Objets et contenants">
                            {{#each inventory.rows}}
                                <li class="aa-inventory-row{{#if container}} aa-inventory-container{{/if}}"
                                    style="--aa-inventory-depth: {{depth}}"
                                    data-inventory-drop="{{id}}"
                                    {{#if @root.canEditState}}draggable="true" data-inventory-drag="{{id}}"{{/if}}>
                                    {{#if container}}
                                        <button type="button" class="aa-inventory-disclosure" data-action="toggleInventoryContainer"
                                            data-item-id="{{id}}" aria-expanded="{{expanded}}"
                                            aria-label="{{#if expanded}}Replier{{else}}Déplier{{/if}} {{name}}"
                                            title="{{#if expanded}}Replier{{else}}Déplier{{/if}}">{{#if expanded}}▾{{else}}▸{{/if}}</button>
                                    {{/if}}
                                    {{#if quantity}}
                                        <input class="aa-inventory-quantity" type="number" min="1" step="1" required value="{{quantity}}"
                                            data-inventory-quantity="{{id}}" aria-label="Quantité de {{name}}"
                                            {{#unless @root.canEditState}}readonly{{/unless}}>
                                    {{/if}}
                                    <span class="aa-inventory-name">{{name}}</span>
                                    {{#if coins.length}}
                                        <span class="aa-inventory-coins">
                                            {{#each coins}}
                                                <label title="{{label}}">{{symbol}}
                                                    <input class="aa-inventory-coin-count" type="number" min="0" step="1" required
                                                        id="aa-luqa-{{../id}}-{{key}}" value="{{value}}"
                                                        data-item-id="{{../id}}" data-luqa-denomination="{{key}}"
                                                        aria-label="{{label}} · {{../name}}" {{#unless @root.canEditState}}readonly{{/unless}}>
                                                </label>
                                            {{/each}}
                                        </span>
                                    {{/if}}
                                    {{#if @root.canEditState}}
                                        <div class="aa-equipment-actions">
                                            {{#if canEquip}}
                                                <button type="button" data-action="toggleEquipment" data-item-id="{{id}}">↑ Équiper</button>
                                            {{/if}}
                                            {{#if nested}}
                                                <button type="button" data-action="moveInventoryItemToRoot" data-item-id="{{id}}"
                                                    aria-label="Sortir {{name}} du contenant" title="Remettre hors contenant">↰</button>
                                            {{/if}}
                                            <button type="button" data-action="moveInventoryItem" data-item-id="{{id}}"
                                                aria-label="Déplacer {{name}}" title="Déplacer vers…">↪</button>
                                            <button type="button" data-action="editInventoryItem" data-item-id="{{id}}"
                                                aria-label="Modifier {{name}}" title="Modifier">⚙</button>
                                        </div>
                                    {{/if}}
                                    {{#if showWeight}}
                                        {{#if container}}
                                            {{> inventoryWeight}}
                                        {{else}}
                                            {{> inventoryWeight editableWeight=@root.canEditState}}
                                        {{/if}}
                                    {{/if}}
                                </li>
                            {{/each}}
                        </ul>
                    {{else}}
                        <p class="aa-empty-equipment">Inventaire vide.</p>
                    {{/if}}
                </section>
            </div>

        </section>


        <section
            class="tab{{#if (eq activeSheetTab "arcanology")}} active{{/if}}"
            data-group="sheet"
            data-tab="arcanology"
        >
            <div class="aa-tab-placeholder">
                <h2><span class="aa-heading-icon" aria-hidden="true">🔮</span>Arcanologie</h2>
                <p>À construire.</p>
            </div>
        </section>


        <section
            class="tab{{#if (eq activeSheetTab "information")}} active{{/if}}"
            data-group="sheet"
            data-tab="information"
        >
            <div class="aa-tab-placeholder">
                <h2><span class="aa-heading-icon" aria-hidden="true">📜</span>Informations</h2>
                <p>À construire.</p>
            </div>
        </section>


        <section
            class="tab{{#if (eq activeSheetTab "options")}} active{{/if}}"
            data-group="sheet"
            data-tab="options"
        >
            <div class="aa-tab-placeholder">
                <h2><span class="aa-heading-icon" aria-hidden="true">⚙️</span>Options</h2>
                <p>À construire.</p>
            </div>
        </section>

    </div>

</div>
