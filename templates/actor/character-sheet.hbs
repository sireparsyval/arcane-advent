{{#*inline "damageReductionControls"}}
    <div class="aa-equipment-detail">
        <strong class="aa-equipment-label">Réductions</strong>
        <div class="aa-equipment-options">
            {{#each damageReductions}}
                <span class="aa-equipment-pill">
                    <span>{{label}}</span>
                    <input type="number" value="{{value}}" min="0" aria-label="Réduction contre {{label}}"
                        data-equipment-edit data-item-id="{{../id}}" data-item-field="system.damageReductions.{{type}}">
                    <button type="button" data-action="removeDamageReduction"
                        data-item-id="{{../id}}" data-damage-type="{{type}}"
                        aria-label="Retirer la réduction contre {{label}}" title="Retirer la réduction">×</button>
                </span>
            {{/each}}
            <div class="aa-equipment-add">
                <input type="text" placeholder="Tranchants…" aria-label="Type de dégâts à réduire"
                    data-reduction-type-input data-item-id="{{id}}">
                <input type="number" min="0" placeholder="0" aria-label="Valeur de la réduction"
                    data-reduction-value-input data-item-id="{{id}}">
                <button type="button" data-action="addDamageReduction" data-item-id="{{id}}"
                    aria-label="Ajouter une réduction" title="Ajouter une réduction">+</button>
            </div>
        </div>
    </div>
{{/inline}}
{{#*inline "inventoryWeight"}}
    <span class="aa-inventory-weight aa-inventory-weight-value"
        title="{{#if container}}Poids du contenu{{else}}{{#if isPurse}}Poids des pièces{{else}}Poids unitaire{{/if}}{{/if}}">
        {{#if isPurse}}
            {{weightLabel}}
        {{else if editableWeight}}
            <input class="aa-inventory-weight-input" type="number" min="0" step="any" inputmode="decimal" required
                id="aa-weight-{{id}}" value="{{unitWeight}}" data-inventory-weight="{{id}}"
                aria-label="Poids unitaire en kg · {{name}}">
            <span class="aa-inventory-weight-unit">kg</span>
        {{else}}
            {{weightLabel}}
        {{/if}}
        <span class="aa-inventory-weight-suffix">{{#if perUnit}}/u{{/if}}</span>
    </span>
{{/inline}}
{{#*inline "equippedInventoryControls"}}
    <div class="aa-equipment-actions">
        {{#if @root.canEditState}}
            <button type="button" data-action="toggleEquipment" data-item-id="{{id}}"
                aria-label="Déséquiper" title="Déséquiper">{{#if unequipText}}{{unequipText}}{{else}}↓{{/if}}</button>
            <button type="button" data-action="moveInventoryItem" data-item-id="{{id}}"
                data-inventory-drag="{{id}}" draggable="true"
                aria-label="Déplacer vers un contenant" title="Déplacer vers… (ou glisser)">↪</button>
            <button type="button" data-action="editInventoryItem" data-item-id="{{id}}"
                aria-label="Modifier {{name}}" title="Modifier">⚙</button>
        {{/if}}
        {{#if @root.inventory.showWeights}}
            {{> inventoryWeight}}
        {{/if}}
    </div>
{{/inline}}
<div class="aa-character">

    <header class="aa-header">

        <img
            class="aa-portrait"
            src="{{actor.img}}"
            alt="{{actor.name}}"
        >

        <div class="aa-identity">

            <input
                class="aa-name"
                type="text"
                name="name"
                value="{{actor.name}}"
            >

        </div>

    </header>


    <nav class="aa-tabs tabs" data-group="sheet">

        <a
            class="item{{#if (eq activeSheetTab "core")}} active{{/if}}"
            data-tab="core"
            data-group="sheet"
        >
            Cœur
        </a>

        <a
            class="item{{#if (eq activeSheetTab "equipment")}} active{{/if}}"
            data-tab="equipment"
            data-group="sheet"
        >
            Équipement
        </a>

        <a
            class="item{{#if (eq activeSheetTab "arcanology")}} active{{/if}}"
            data-tab="arcanology"
            data-group="sheet"
        >
            Arcanologie
        </a>

        <a
            class="item{{#if (eq activeSheetTab "information")}} active{{/if}}"
            data-tab="information"
            data-group="sheet"
        >
            Informations
        </a>

        <a
            class="item{{#if (eq activeSheetTab "options")}} active{{/if}}"
            data-tab="options"
            data-group="sheet"
        >
            Options
        </a>

    </nav>

    <div class="aa-tab-content">

        <section
            class="tab{{#if (eq activeSheetTab "core")}} active{{/if}}"
            data-group="sheet"
            data-tab="core"
        >

            <main class="aa-core">

                <div class="aa-core-column">

                <section class="aa-panel aa-status">

                    <h2 class="aa-status-title">
                        Statut
                    </h2>


                    <div class="aa-status-grid">

                        <!-- ========================== -->
                        <!-- PdC                        -->
                        <!-- ========================== -->

                        <div class="aa-status-card aa-status-consciousness">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">❤️</span>
                                <span>Points de Conscience</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-values aa-status-values-large">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousness.value"
                                        value="{{system.consciousness.value}}"
                                    >

                                    <span>/</span>

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousness.max"
                                        value="{{system.consciousness.max}}"
                                    >

                                </div>

                                <div class="aa-status-bar">

                                    <div
                                        class="aa-status-bar-fill"
                                        style="width: {{system.consciousness.percentage}}%;"
                                    ></div>

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- Dés de Conscience          -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">🎲</span>
                                <span>Dés de Conscience</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-values aa-consciousness-dice-values">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousnessDice.value"
                                        value="{{system.consciousnessDice.value}}"
                                    >

                                    <span>/</span>

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousnessDice.max"
                                        value="{{system.consciousnessDice.max}}"
                                    >

                                    <button type="button" data-action="rollConsciousnessDie"
                                        aria-label="Lancer le dé de conscience" title="Lancer le dé de conscience">🎲</button>

                                </div>

                                <input
                                    class="aa-consciousness-die-formula"
                                    type="text"
                                    name="system.consciousnessDice.formula"
                                    value="{{system.consciousnessDice.formula}}"
                                    placeholder="1d8 + 2"
                                >

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- Barrière                   -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">🛡️</span>
                                <span>Points de Barrière</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-single-value">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.barrier"
                                        value="{{system.barrier}}"
                                    >

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- PdF                        -->
                        <!-- ========================== -->

                        <div class="aa-status-card aa-status-fever">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">⚡</span>
                                <span>Points de Fièvre</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-values aa-status-values-large">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.fever.value"
                                        value="{{system.fever.value}}"
                                    >

                                    <span>/</span>

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.fever.max"
                                        value="{{system.fever.max}}"
                                    >

                                </div>

                                <div class="aa-status-bar">

                                    <div
                                        class="aa-status-bar-fill"
                                        style="width: {{system.fever.percentage}}%;"
                                    ></div>

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- JS contre la mort          -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">☠️</span>
                                <span>Contre-la-Mort</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-death-saves">
                                    {{#each deathSaves}}
                                        <div class="aa-death-save-group">
                                            <span>{{label}}</span>
                                            <div class="aa-death-save-boxes" role="group" aria-label="{{label}}">
                                                {{#each steps}}
                                                    <button type="button" data-action="stepTrack" data-track="deathSaves"
                                                        data-key="{{../key}}" data-index="{{index}}" aria-pressed="{{filled}}"
                                                        aria-label="{{../label}}, coche {{index}} sur 3"
                                                        {{#unless @root.canEditState}}disabled{{/unless}}>
                                                        {{#if filled}}<span aria-hidden="true">✓</span>{{/if}}
                                                    </button>
                                                {{/each}}
                                            </div>
                                        </div>
                                    {{/each}}
                                </div>

                                <button type="button" class="aa-death-save-roll" data-action="rollDeathSave"
                                    {{#unless canEditState}}disabled{{/unless}}>🎲 Contre-la-Mort</button>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- Miséricorde                -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">💫</span>
                                <span>Points de Miséricorde</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-single-value">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.mercy"
                                        value="{{system.mercy}}"
                                    >

                                </div>

                            </div>
                            <button type="button" class="aa-mercy-help" data-action="showMercyHelp"
                                aria-label="Aide sur les points de Miséricorde"
                                data-tooltip-text="À construire" data-tooltip-direction="UP">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                            </button>
                        </div>

                    </div>

                </section>

                <section class="aa-panel">
                    <div class="aa-condition-heading aa-aptitude-heading">
                        <h2 class="aa-status-title">Aptitudes</h2>
                        {{#if canEditState}}
                            <button type="button" data-action="addAptitude"
                                aria-label="Ajouter une aptitude" title="Ajouter une aptitude">
                                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            </button>
                        {{/if}}
                    </div>
                    {{#each aptitudes}}
                        <div class="aa-condition-row aa-aptitude-row" data-sheet-sort-drop="{{id}}">
                            {{#if @root.canEditState}}
                                <div class="aa-aptitude-identity">
                                    <span class="aa-sort-handle" draggable="true" data-sheet-sort-drag="{{id}}" aria-label="Réordonner {{name}}" title="Glisser pour réordonner">⠿</span>
                                    <label class="aa-aptitude-type">
                                        <span>Type</span>
                                        <select data-aptitude-field="category" data-item-id="{{id}}">
                                            {{#each @root.aptitudeCategories}}
                                                <option value="{{@key}}" {{#if (eq @key ../system.category)}}selected{{/if}}>{{this}}</option>
                                            {{/each}}
                                        </select>
                                    </label>
                                    <label class="aa-aptitude-level">
                                        <span>Niv.</span>
                                        <input type="number" min="0" step="1" required value="{{system.level}}"
                                            data-aptitude-field="level" data-item-id="{{id}}">
                                    </label>
                                    <label class="aa-aptitude-name">
                                        <span>Nom</span>
                                        <input type="text" required pattern=".*\S.*" value="{{name}}"
                                            data-aptitude-field="name" data-item-id="{{id}}">
                                    </label>
                                    <div class="aa-aptitude-actions">
                                        <button type="button" data-action="toggleAptitudeConfig" aria-expanded="{{configOpen}}"
                                            aria-label="Champs facultatifs de {{name}}" title="Champs facultatifs">
                                            <i class="fa-solid fa-gear" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" data-action="deleteAptitude" data-item-id="{{id}}"
                                            aria-label="Retirer {{name}}" title="Retirer l’aptitude">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="aa-aptitude-config" data-aptitude-config="{{id}}" {{#unless configOpen}}hidden{{/unless}}>
                                    {{#each options}}
                                        <button type="button" data-action="toggleAptitudeOption" data-item-id="{{../id}}"
                                            data-option="{{key}}" aria-pressed="{{active}}">{{label}}</button>
                                    {{/each}}
                                    <button type="button" class="aa-aptitude-add-roll" data-action="editAptitudeRoll" data-item-id="{{id}}"
                                        aria-label="Ajouter un jet" title="Ajouter un jet">+🎲</button>
                                </div>
                            {{else}}
                                <div class="aa-aptitude-identity">
                                    <strong>{{name}}</strong>
                                    <span class="aa-condition-level">{{categoryLabel}} · Niv. {{system.level}} ({{system.level}} PdF)</span>
                                </div>
                            {{/if}}
                            <div class="aa-aptitude-optional">
                                {{#each options}}
                                    {{#if active}}
                                        <div class="aa-aptitude-option aa-aptitude-option-{{key}}">
                                            <strong>{{label}}</strong>
                                            {{#if @root.canEditState}}
                                                {{#if (eq key "duration")}}
                                                    <div class="aa-aptitude-option-line">
                                                        <input type="number" min="0" step="1" required value="{{value}}"
                                                            data-aptitude-field="durationTurns" data-item-id="{{../id}}" aria-label="Durée">
                                                        <select class="aa-aptitude-duration-unit" data-aptitude-field="durationUnit"
                                                            data-item-id="{{../id}}" aria-label="Unité de durée">
                                                            {{#each @root.aptitudeDurationUnits}}
                                                                <option value="{{@key}}" {{#if (eq @key ../../system.durationUnit)}}selected{{/if}}>{{this}}</option>
                                                            {{/each}}
                                                        </select>
                                                    </div>
                                                {{else}}
                                                    <div class="aa-aptitude-option-line">
                                                        <div class="aa-aptitude-counter">
                                                            <input type="number" min="0" max="{{value.max}}" step="1" required value="{{value.remaining}}"
                                                                data-aptitude-field="{{key}}Counter.remaining" data-item-id="{{../id}}"
                                                                aria-label="{{label}} — restant" title="Restant">
                                                            <span aria-hidden="true">/</span>
                                                            <input type="number" min="0" step="1" required value="{{value.max}}"
                                                                data-aptitude-field="{{key}}Counter.max" data-item-id="{{../id}}"
                                                                aria-label="{{label}} — max" title="Max">
                                                        </div>
                                                        {{#if (eq key "recovery")}}
                                                            <select data-aptitude-field="recoveryCounter.unit" data-item-id="{{../id}}" aria-label="Unité de récupération">
                                                                {{#each @root.aptitudeRecoveryUnits}}
                                                                    <option value="{{@key}}" {{#if (eq @key ../value.unit)}}selected{{/if}}>{{this}}</option>
                                                                {{/each}}
                                                            </select>
                                                        {{/if}}
                                                    </div>
                                                {{/if}}
                                            {{else}}
                                                <span>
                                                    {{#if (eq key "duration")}}
                                                        {{value}} {{../durationUnitLabel}}
                                                    {{else}}
                                                        {{value.remaining}} / {{value.max}}{{#if (eq key "recovery")}} {{../recoveryUnitLabel}}{{/if}}
                                                    {{/if}}
                                                </span>
                                            {{/if}}
                                            {{#if note}}<small>Ancienne valeur · {{note}}</small>{{/if}}
                                        </div>
                                    {{/if}}
                                {{/each}}
                            </div>
                            {{#if rolls}}
                                <div class="aa-aptitude-rolls">
                                    {{#each rolls}}
                                        <div class="aa-aptitude-roll">
                                            <button type="button" data-action="rollAptitude" data-item-id="{{../id}}" data-roll-id="{{id}}">
                                                <span aria-hidden="true">🎲</span> {{name}}
                                            </button>
                                            {{#if @root.canEditState}}
                                                <button type="button" class="aa-aptitude-edit-roll" data-action="editAptitudeRoll"
                                                    data-item-id="{{../id}}" data-roll-id="{{id}}" aria-label="Modifier {{name}}" title="Modifier {{name}}">
                                                    <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                                </button>
                                            {{/if}}
                                        </div>
                                    {{/each}}
                                </div>
                            {{/if}}
                            <details data-aptitude-description="{{id}}" {{#if descriptionOpen}}open{{/if}}>
                                <summary>Effets et utilisation</summary>
                                {{#if @root.canEditState}}
                                    <textarea rows="4" data-aptitude-field="description" data-item-id="{{id}}"
                                        aria-label="Effets et utilisation de {{name}}">{{system.description}}</textarea>
                                {{else}}
                                    <p>{{#if system.description}}{{system.description}}{{else}}Aucune description.{{/if}}</p>
                                {{/if}}
                            </details>
                        </div>
                    {{else}}
                        <p class="aa-condition-empty">Aucune aptitude.</p>
                    {{/each}}
                </section>


                <section class="aa-panel">
                    <h2 class="aa-status-title">
                        État du personnage
                    </h2>

                    {{#each conditionSections}}
                        <div class="aa-condition-group">
                            <div class="aa-condition-heading">
                                <h3>{{title}}</h3>
                                {{#if @root.canEditState}}
                                    <button type="button" data-action="editCondition" data-condition-type="{{type}}"
                                        aria-label="{{addLabel}}" title="{{addLabel}}">
                                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                    </button>
                                {{/if}}
                            </div>

                            {{#each entries}}
                                <div class="aa-condition-row">
                                    <details>
                                        <summary>{{name}}</summary>
                                        <p>{{#if description}}{{description}}{{else}}Aucune description.{{/if}}</p>
                                    </details>
                                    <span class="aa-condition-level">
                                        {{../severityShort}} {{severity}}{{#if zone}} · {{zone}}{{/if}}{{#if durationLabel}} · ⏳ {{durationLabel}}{{/if}}
                                    </span>
                                    {{#if @root.canEditState}}
                                        <button type="button" data-action="editCondition" data-item-id="{{id}}"
                                            aria-label="Modifier {{name}}" title="Modifier">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" data-action="deleteCondition" data-item-id="{{id}}"
                                            aria-label="Retirer {{name}}" title="Retirer">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </button>
                                    {{/if}}
                                </div>
                            {{else}}
                                <p class="aa-condition-empty">{{empty}}</p>
                            {{/each}}
                        </div>
                    {{/each}}

                    <div class="aa-condition-group">
                        <div class="aa-needs">
                            {{#each needs}}
                                <div class="aa-need-column" role="group" aria-label="{{label}}">
                                    <strong>{{label}}</strong>
                                    <div class="aa-need-meter" aria-hidden="true">
                                        {{#each steps}}
                                            <span {{#if filled}}class="is-filled"{{/if}}></span>
                                        {{/each}}
                                    </div>
                                    {{#each levels}}
                                        <button type="button" class="aa-need-level" data-action="stepTrack" data-track="needs"
                                            data-key="{{../key}}" data-index="{{index}}" aria-pressed="{{selected}}"
                                            aria-label="{{../label}} — {{name}} ({{index}} sur {{../max}})"
                                            {{#unless @root.canEditState}}disabled{{/unless}}>{{name}}</button>
                                    {{/each}}
                                </div>
                            {{/each}}
                        </div>
                    </div>
                </section>

                </div>

                <div class="aa-core-column">

                <section class="aa-panel aa-abilities">

                    <h2 class="aa-status-title">
                        Caractéristiques
                    </h2>

                    <div class="aa-ability-grid">

                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="strength"
                            >
                                FOR
                            </button>

                            <input
                                type="number"
                                name="system.abilities.strength.value"
                                value="{{system.abilities.strength.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.strength.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="dexterity"
                            >
                                DEX
                            </button>

                            <input
                                type="number"
                                name="system.abilities.dexterity.value"
                                value="{{system.abilities.dexterity.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.dexterity.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="constitution"
                            >
                                CON
                            </button>

                            <input
                                type="number"
                                name="system.abilities.constitution.value"
                                value="{{system.abilities.constitution.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.constitution.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="intelligence"
                            >
                                INT
                            </button>

                            <input
                                type="number"
                                name="system.abilities.intelligence.value"
                                value="{{system.abilities.intelligence.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.intelligence.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="wisdom"
                            >
                                SAG
                            </button>

                            <input
                                type="number"
                                name="system.abilities.wisdom.value"
                                value="{{system.abilities.wisdom.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.wisdom.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="charisma"
                            >
                                CHA
                            </button>

                            <input
                                type="number"
                                name="system.abilities.charisma.value"
                                value="{{system.abilities.charisma.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.charisma.modifier}}
                            </span>
                        </div>

                    </div>

                    <section class="aa-defense-panel">

                        <div class="aa-defense-header">

                            <h3><span class="aa-heading-icon" aria-hidden="true">🛡️</span>Défense</h3>


                            <div class="aa-defense-mode" role="group" aria-label="Mode de Défense">
                                {{#each defenseModes}}
                                    <button type="button" data-action="setDefenseMode" data-defense-mode="{{key}}"
                                        aria-pressed="{{selected}}" {{#unless @root.canEditState}}disabled{{/unless}}
                                        {{#if (eq key "best")}}title="Utilise le meilleur des deux modificateurs"{{/if}}>{{label}}</button>
                                {{/each}}
                            </div>


