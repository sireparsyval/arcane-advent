<div class="aa-character">

    <header class="aa-header">

        <img
            class="aa-portrait"
            src="{{actor.img}}"
            alt="{{actor.name}}"
        >

        <div class="aa-identity">

            <input
                class="aa-name"
                type="text"
                name="name"
                value="{{actor.name}}"
            >

        </div>

    </header>


    <nav class="aa-tabs tabs" data-group="sheet">

        <a
            class="item"
            data-tab="core"
            data-group="sheet"
        >
            Cœur
        </a>

        <a
            class="item"
            data-tab="equipment"
            data-group="sheet"
        >
            Équipement
        </a>

        <a
            class="item"
            data-tab="arcanology"
            data-group="sheet"
        >
            Arcanologie
        </a>

        <a
            class="item"
            data-tab="information"
            data-group="sheet"
        >
            Informations
        </a>

        <a
            class="item"
            data-tab="options"
            data-group="sheet"
        >
            Options
        </a>

    </nav>

    <div class="aa-tab-content">

        <section
            class="tab"
            data-group="sheet"
            data-tab="core"
        >

            <main class="aa-core">

                <div class="aa-core-column">

                <section class="aa-panel aa-status">

                    <h2 class="aa-status-title">
                        Statut
                    </h2>


                    <div class="aa-status-grid">

                        <!-- ========================== -->
                        <!-- PdC                        -->
                        <!-- ========================== -->

                        <div class="aa-status-card aa-status-consciousness">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">❤️</span>
                                <span>Points de Conscience</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-values aa-status-values-large">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousness.value"
                                        value="{{system.consciousness.value}}"
                                    >

                                    <span>/</span>

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousness.max"
                                        value="{{system.consciousness.max}}"
                                    >

                                </div>

                                <div class="aa-status-bar">

                                    <div
                                        class="aa-status-bar-fill"
                                        style="width: {{system.consciousness.percentage}}%;"
                                    ></div>

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- Dés de Conscience          -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">🎲</span>
                                <span>Dés de Conscience</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-values">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousnessDice.value"
                                        value="{{system.consciousnessDice.value}}"
                                    >

                                    <span>/</span>

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.consciousnessDice.max"
                                        value="{{system.consciousnessDice.max}}"
                                    >

                                </div>

                                <input
                                    class="aa-consciousness-die-formula"
                                    type="text"
                                    name="system.consciousnessDice.formula"
                                    value="{{system.consciousnessDice.formula}}"
                                    placeholder="1d8 + 2"
                                >

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- Barrière                   -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">🛡️</span>
                                <span>Points de Barrière</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-single-value">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.barrier"
                                        value="{{system.barrier}}"
                                    >

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- PdF                        -->
                        <!-- ========================== -->

                        <div class="aa-status-card aa-status-fever">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">⚡</span>
                                <span>Points de Fièvre</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-values aa-status-values-large">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.fever.value"
                                        value="{{system.fever.value}}"
                                    >

                                    <span>/</span>

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.fever.max"
                                        value="{{system.fever.max}}"
                                    >

                                </div>

                                <div class="aa-status-bar">

                                    <div
                                        class="aa-status-bar-fill"
                                        style="width: {{system.fever.percentage}}%;"
                                    ></div>

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- JS contre la mort          -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">☠️</span>
                                <span>Contre-la-Mort</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-death-saves">

                                    <div class="aa-death-save-group">

                                        <span>
                                            Réussites
                                        </span>

                                        <div class="aa-death-save-boxes">

                                            <input
                                                type="checkbox"
                                                {{#if deathSaves.successes.[0]}}checked{{/if}}
                                                data-death-save="successes"
                                                data-death-save-index="1"
                                            >

                                            <input
                                                type="checkbox"
                                                {{#if deathSaves.successes.[1]}}checked{{/if}}
                                                data-death-save="successes"
                                                data-death-save-index="2"
                                            >

                                            <input
                                                type="checkbox"
                                                {{#if deathSaves.successes.[2]}}checked{{/if}}
                                                data-death-save="successes"
                                                data-death-save-index="3"
                                            >

                                        </div>

                                    </div>

                                    <div class="aa-death-save-group">

                                        <span>
                                            Échecs
                                        </span>

                                        <div class="aa-death-save-boxes">

                                            <input
                                                type="checkbox"
                                                {{#if deathSaves.failures.[0]}}checked{{/if}}
                                                data-death-save="failures"
                                                data-death-save-index="1"
                                            >

                                            <input
                                                type="checkbox"
                                                {{#if deathSaves.failures.[1]}}checked{{/if}}
                                                data-death-save="failures"
                                                data-death-save-index="2"
                                            >

                                            <input
                                                type="checkbox"
                                                {{#if deathSaves.failures.[2]}}checked{{/if}}
                                                data-death-save="failures"
                                                data-death-save-index="3"
                                            >

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ========================== -->
                        <!-- Miséricorde                -->
                        <!-- ========================== -->

                        <div class="aa-status-card">

                            <strong class="aa-status-heading">
                                <span class="aa-status-icon" aria-hidden="true">💫</span>
                                <span>Points de Miséricorde</span>
                            </strong>

                            <div class="aa-status-content">

                                <div class="aa-status-single-value">

                                    <input
                                        type="number"
                                        min="0"
                                        name="system.mercy"
                                        value="{{system.mercy}}"
                                    >

                                </div>

                            </div>

                        </div>

                    </div>

                </section>

                <section class="aa-panel">
                    <h2 class="aa-status-title">
                        Aptitudes
                    </h2>
                </section>


                <section class="aa-panel">
                    <h2 class="aa-status-title">
                        Conditions
                    </h2>

                    <div class="aa-roll-mode">
                        <label for="roll-mode">Jets</label>

                        <select
                            id="roll-mode"
                            name="system.rollMode"
                        >
                            <option
                                value="advantage"
                                {{#if (eq system.rollMode "advantage")}}selected{{/if}}
                            >
                                Avantage
                            </option>

                            <option
                                value="normal"
                                {{#if (eq system.rollMode "normal")}}selected{{/if}}
                            >
                                Neutre
                            </option>

                            <option
                                value="disadvantage"
                                {{#if (eq system.rollMode "disadvantage")}}selected{{/if}}
                            >
                                Désavantage
                            </option>
                        </select>
                    </div>

                    <p>
                        Conditions, blessures, besoins,
                        climat et moral.
                    </p>
                </section>

                </div>

                <div class="aa-core-column">

                <section class="aa-panel aa-abilities">

                    <h2 class="aa-status-title">
                        Caractéristiques
                    </h2>

                    <div class="aa-ability-grid">

                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="strength"
                            >
                                FOR
                            </button>

                            <input
                                type="number"
                                name="system.abilities.strength.value"
                                value="{{system.abilities.strength.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.strength.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="dexterity"
                            >
                                DEX
                            </button>

                            <input
                                type="number"
                                name="system.abilities.dexterity.value"
                                value="{{system.abilities.dexterity.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.dexterity.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="constitution"
                            >
                                CON
                            </button>

                            <input
                                type="number"
                                name="system.abilities.constitution.value"
                                value="{{system.abilities.constitution.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.constitution.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="intelligence"
                            >
                                INT
                            </button>

                            <input
                                type="number"
                                name="system.abilities.intelligence.value"
                                value="{{system.abilities.intelligence.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.intelligence.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="wisdom"
                            >
                                SAG
                            </button>

                            <input
                                type="number"
                                name="system.abilities.wisdom.value"
                                value="{{system.abilities.wisdom.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.wisdom.modifier}}
                            </span>
                        </div>


                        <div class="aa-ability">
                            <button
                                type="button"
                                class="aa-ability-roll"
                                data-action="rollAbility"
                                data-ability="charisma"
                            >
                                CHA
                            </button>

                            <input
                                type="number"
                                name="system.abilities.charisma.value"
                                value="{{system.abilities.charisma.value}}"
                            >

                            <span class="aa-modifier">
                                {{system.abilities.charisma.modifier}}
                            </span>
                        </div>

                    </div>

                    <section class="aa-defense-panel">

                        <div class="aa-defense-header">

                            <h3><span class="aa-heading-icon" aria-hidden="true">🛡️</span>Défense</h3>


                            <label>
                                Base

                                <select name="system.defense.mode" title="↑ DEX/CON : utilise le meilleur des deux modificateurs">

                                    <option
                                        value="dex"
                                        {{#if (eq system.defense.mode "dex")}}
                                            selected
                                        {{/if}}
                                    >
                                        DEX
                                    </option>


                                    <option
                                        value="con"
                                        {{#if (eq system.defense.mode "con")}}
                                            selected
                                        {{/if}}
                                    >
                                        CON
                                    </option>


                                    <option
                                        value="best"
                                        {{#if (eq system.defense.mode "best")}}
                                            selected
                                        {{/if}}
                                    >
                                        ↑ DEX/CON
                                    </option>

                                </select>
                            </label>


                            {{#if system.defense.shieldBonus}}
                                <span class="aa-defense-base">
                                    + Bouclier {{system.defense.shieldBonus}}
                                </span>
                            {{/if}}

                        </div>


                        <div class="aa-defense-zones">

                            <div class="aa-defense-zone">

                                <span>Tête</span>

                                <strong>
                                    {{system.defense.zones.head}}
                                </strong>

                            </div>


                            <div class="aa-defense-zone">

                                <span>Torse</span>

                                <strong>
                                    {{system.defense.zones.torso}}
                                </strong>

                            </div>


                            <div class="aa-defense-zone">

                                <span>Bras</span>

                                <strong>
                                    {{system.defense.zones.arms}}
                                </strong>

                            </div>


                            <div class="aa-defense-zone">

                                <span>Jambes</span>

                                <strong>
                                    {{system.defense.zones.legs}}
                                </strong>

                            </div>

                        </div>


                        {{#if guardSources.length}}

                            <div class="aa-guard-section">

                                <strong>Garde</strong>


                                {{#each guardSources}}

                                    <button
                                        type="button"
                                        data-action="rollGuard"
                                        data-item-id="{{id}}"
                                        title="Garde avec {{name}}"
                                    >
                                        🛡️ {{name}} — {{value}}
                                    </button>

                                {{/each}}

                            </div>

                        {{/if}}

                    </section>

                    <div class="aa-trackers">

                        <div class="aa-tracker">
                            <label>Perception</label>

                            <strong>
                                {{system.trackers.passivePerception}}
                            </strong>
                        </div>


                        <div class="aa-tracker">
                            <label>Initiative</label>

                            <strong>
                                {{system.trackers.initiative}}
                            </strong>
                        </div>


                        <div class="aa-tracker">
                            <label>Vitesse</label>

                            <div class="aa-tracker-value">
                                <input
                                    type="number"
                                    name="system.trackers.speed"
                                    value="{{system.trackers.speed}}"
                                >

                                <span>m</span>
                            </div>
                        </div>

                    </div>

                </section>

                <section class="aa-panel aa-masteries">

                    <h2 class="aa-status-title">
                        Maîtrises
                    </h2>


                    <!-- ========================= -->
                    <!-- JETS DE SAUVEGARDE        -->
                    <!-- ========================= -->

                    <section class="aa-mastery-section">

                        <h3><span class="aa-heading-icon" aria-hidden="true">🎲</span>Jets de sauvegarde</h3>

                        <div class="aa-save-grid">

                            <div class="aa-save">
                                <button
                                    type="button"
                                    class="aa-save-roll"
                                    data-action="rollSavingThrow"
                                    data-ability="strength"
                                >
                                    FOR
                                </button>

                                <input
                                    type="number"
                                    name="system.savingThrows.strength.mastery"
                                    value="{{system.savingThrows.strength.mastery}}"
                                >

                                <strong>
                                    {{system.savingThrows.strength.total}}
                                </strong>
                            </div>


                            <div class="aa-save">
                                <button
                                    type="button"
                                    class="aa-save-roll"
                                    data-action="rollSavingThrow"
                                    data-ability="dexterity"
                                >
                                    DEX
                                </button>

                                <input
                                    type="number"
                                    name="system.savingThrows.dexterity.mastery"
                                    value="{{system.savingThrows.dexterity.mastery}}"
                                >

                                <strong>
                                    {{system.savingThrows.dexterity.total}}
                                </strong>
                            </div>


                            <div class="aa-save">
                                <button
                                    type="button"
                                    class="aa-save-roll"
                                    data-action="rollSavingThrow"
                                    data-ability="constitution"
                                >
                                    CON
                                </button>

                                <input
                                    type="number"
                                    name="system.savingThrows.constitution.mastery"
                                    value="{{system.savingThrows.constitution.mastery}}"
                                >

                                <strong>
                                    {{system.savingThrows.constitution.total}}
                                </strong>
                            </div>


                            <div class="aa-save">
                                <button
                                    type="button"
                                    class="aa-save-roll"
                                    data-action="rollSavingThrow"
                                    data-ability="intelligence"
                                >
                                    INT
                                </button>

                                <input
                                    type="number"
                                    name="system.savingThrows.intelligence.mastery"
                                    value="{{system.savingThrows.intelligence.mastery}}"
                                >

                                <strong>
                                    {{system.savingThrows.intelligence.total}}
                                </strong>
                            </div>


                            <div class="aa-save">
                                <button
                                    type="button"
                                    class="aa-save-roll"
                                    data-action="rollSavingThrow"
                                    data-ability="wisdom"
                                >
                                    SAG
                                </button>

                                <input
                                    type="number"
                                    name="system.savingThrows.wisdom.mastery"
                                    value="{{system.savingThrows.wisdom.mastery}}"
                                >

                                <strong>
                                    {{system.savingThrows.wisdom.total}}
                                </strong>
                            </div>


                            <div class="aa-save">
                                <button
                                    type="button"
                                    class="aa-save-roll"
                                    data-action="rollSavingThrow"
                                    data-ability="charisma"
                                >
                                    CHA
                                </button>

                                <input
                                    type="number"
                                    name="system.savingThrows.charisma.mastery"
                                    value="{{system.savingThrows.charisma.mastery}}"
                                >

                                <strong>
                                    {{system.savingThrows.charisma.total}}
                                </strong>
                            </div>

                        </div>

                    </section>


                    <!-- ========================= -->
                    <!-- COMPÉTENCES               -->
                    <!-- ========================= -->

                    <section class="aa-mastery-section">

                        <div class="aa-section-title">

                            <h3><span class="aa-heading-icon" aria-hidden="true">🧭</span>Compétences</h3>

                            <button
                                type="button"
                                data-action="addSkill"
                            >
                                + Ajouter
                            </button>

                        </div>


                        <div class="aa-skill-header">
                            <span></span>
                            <span>Compétence</span>
                            <span>Carac.</span>
                            <span>Maîtrise</span>
                            <span>Total</span>
                            <span></span>
                        </div>


                        <div class="aa-skill-list">

                            {{#each skills}}

                                <div class="aa-skill-row">

                                    <button
                                        type="button"
                                        class="aa-skill-roll"
                                        data-action="rollSkill"
                                        data-skill-id="{{id}}"
                                        title="Lancer le jet"
                                    >
                                        🎲
                                    </button>


                                    <input
                                        type="text"
                                        value="{{name}}"
                                        data-skill-edit
                                        data-skill-id="{{id}}"
                                        data-skill-field="name"
                                    >


                                    <select
                                        data-skill-edit
                                        data-skill-id="{{id}}"
                                        data-skill-field="system.ability"
                                    >

                                        <option
                                            value="strength"
                                            {{#if (eq ability "strength")}}selected{{/if}}
                                        >
                                            FOR
                                        </option>

                                        <option
                                            value="dexterity"
                                            {{#if (eq ability "dexterity")}}selected{{/if}}
                                        >
                                            DEX
                                        </option>

                                        <option
                                            value="constitution"
                                            {{#if (eq ability "constitution")}}selected{{/if}}
                                        >
                                            CON
                                        </option>

                                        <option
                                            value="intelligence"
                                            {{#if (eq ability "intelligence")}}selected{{/if}}
                                        >
                                            INT
                                        </option>

                                        <option
                                            value="wisdom"
                                            {{#if (eq ability "wisdom")}}selected{{/if}}
                                        >
                                            SAG
                                        </option>

                                        <option
                                            value="charisma"
                                            {{#if (eq ability "charisma")}}selected{{/if}}
                                        >
                                            CHA
                                        </option>

                                    </select>


                                    <input
                                        type="number"
                                        value="{{mastery}}"
                                        data-skill-edit
                                        data-skill-id="{{id}}"
                                        data-skill-field="system.mastery"
                                    >


                                    <strong>
                                        {{total}}
                                    </strong>


                                    <button
                                        type="button"
                                        class="aa-skill-delete"
                                        data-action="deleteSkill"
                                        data-skill-id="{{id}}"
                                        title="Supprimer"
                                    >
                                        ×
                                    </button>

                                </div>

                            {{else}}

                                <p class="aa-empty-skills">
                                    Aucune compétence.
                                </p>

                            {{/each}}

                        </div>

                    </section>


                    <!-- ========================= -->
                    <!-- EXPERTISES                -->
                    <!-- ========================= -->

                    <section class="aa-mastery-section">

                        <div class="aa-section-title">

                            <h3><span class="aa-heading-icon" aria-hidden="true">🏅</span>Expertises</h3>

                            <button
                                type="button"
                                data-action="addExpertise"
                            >
                                + Ajouter
                            </button>

                        </div>


                        <div class="aa-expertise-header">
                            <span>Expertise</span>
                            <span>Domaine</span>
                            <span>Cible</span>
                            <span>Bonus</span>
                            <span></span>
                        </div>


                        <div class="aa-expertise-list">

                            {{#each expertises}}

                                <div class="aa-expertise-row">

                                    <input
                                        type="text"
                                        value="{{name}}"
                                        data-expertise-edit
                                        data-expertise-id="{{id}}"
                                        data-expertise-field="name"
                                    >


                                    <select
                                        data-expertise-edit
                                        data-expertise-id="{{id}}"
                                        data-expertise-field="system.domain"
                                    >

                                        <option
                                            value="weaponClass"
                                            {{#if (eq domain "weaponClass")}}selected{{/if}}
                                        >
                                            Classe d'arme
                                        </option>

                                        <option
                                            value="shieldClass"
                                            {{#if (eq domain "shieldClass")}}selected{{/if}}
                                        >
                                            Classe de bouclier
                                        </option>

                                        <option
                                            value="armorClass"
                                            {{#if (eq domain "armorClass")}}selected{{/if}}
                                        >
                                            Classe d'armure
                                        </option>

                                        <option
                                            value="toolObject"
                                            {{#if (eq domain "toolObject")}}selected{{/if}}
                                        >
                                            Outil / Objet
                                        </option>

                                        <option
                                            value="other"
                                            {{#if (eq domain "other")}}selected{{/if}}
                                        >
                                            Autre
                                        </option>

                                    </select>


                                    <input
                                        type="text"
                                        value="{{target}}"
                                        placeholder="ex : Épée"
                                        data-expertise-edit
                                        data-expertise-id="{{id}}"
                                        data-expertise-field="system.target"
                                    >


                                    <input
                                        type="number"
                                        value="{{bonus}}"
                                        data-expertise-edit
                                        data-expertise-id="{{id}}"
                                        data-expertise-field="system.bonus"
                                    >


                                    <button
                                        type="button"
                                        data-action="deleteExpertise"
                                        data-expertise-id="{{id}}"
                                    >
                                        ×
                                    </button>

                                </div>

                            {{else}}

                                <p class="aa-empty-skills">
                                    Aucune expertise.
                                </p>

                            {{/each}}

                        </div>

                    </section>

                </section>

                </div>

            </main>

        </section>


        <section
            class="tab"
            data-group="sheet"
            data-tab="equipment"
        >

            <div class="aa-equipment-tab">
                <div class="aa-equipment-heading">
                    <h2><span class="aa-heading-icon" aria-hidden="true">🎒</span>Équipement</h2>

                    <div class="aa-equipment-create">
                        <button type="button" data-action="addEquipment" data-equipment-type="weapon">+ Arme</button>
                        <button type="button" data-action="addEquipment" data-equipment-type="shield">+ Bouclier</button>
                        <button type="button" data-action="addEquipment" data-equipment-type="protection">+ Protection</button>
                        <button type="button" data-action="addEquipment" data-equipment-type="accessory">+ Accessoire</button>
                    </div>
                </div>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">⚔️</span>Armes équipées</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.weapons}}
                            <div class="aa-equipment-card">
                                <div class="aa-equipment-identity">
                                    <label class="aa-equipment-field">
                                        <span>Nom</span>
                                        <input type="text" value="{{name}}"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                    </label>
                                    <label class="aa-equipment-field">
                                        <span>Classe</span>
                                        <input type="text" value="{{system.weaponClass}}" placeholder="Épée"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="system.weaponClass">
                                    </label>
                                    <div class="aa-equipment-actions">
                                        <button type="button" data-action="toggleEquipment" data-item-id="{{id}}"
                                            aria-label="Déséquiper" title="Déséquiper">↓</button>
                                        <button type="button" data-action="deleteEquipment" data-item-id="{{id}}"
                                            aria-label="Supprimer" title="Supprimer">×</button>
                                    </div>
                                </div>

                                <div class="aa-weapon-combat">
                                    <div class="aa-weapon-attack">
                                        <span class="aa-equipment-stat" title="Caractéristique utilisée">{{attackAbility}}</span>
                                        <span class="aa-equipment-stat" title="Bonus d'Expertise">Exp. {{expertiseBonus}}</span>
                                        <button type="button" data-action="rollWeaponAttack" data-item-id="{{id}}"
                                            title="Jet d'attaque">🎲 Attaque {{attackTotal}}</button>
                                    </div>
                                    <div class="aa-weapon-damage">
                                        <label class="aa-equipment-inline">
                                            <span>Dégâts</span>
                                            <input type="text" value="{{system.damageFormula}}" placeholder="1d6"
                                                data-equipment-edit data-item-id="{{id}}" data-item-field="system.damageFormula">
                                        </label>
                                        <button type="button" data-action="rollWeaponDamage" data-item-id="{{id}}"
                                            aria-label="Jet de dégâts" title="Jet de dégâts">🎲</button>
                                    </div>
                                    <label class="aa-weapon-range aa-equipment-inline">
                                        <span>Portée</span>
                                        <input type="number" value="{{system.range}}"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="system.range">
                                        <span>m</span>
                                    </label>
                                </div>

                                <div class="aa-equipment-detail">
                                    <strong class="aa-equipment-label">Types de dégâts</strong>
                                    <div class="aa-equipment-options">
                                        {{#each damageTypes}}
                                            <span class="aa-equipment-pill">
                                                <span>{{this}}</span>
                                                <button type="button" data-action="removeWeaponDamageType"
                                                    data-item-id="{{../id}}" data-damage-type="{{this}}"
                                                    aria-label="Retirer le type {{this}}" title="Retirer">×</button>
                                            </span>
                                        {{/each}}
                                        <div class="aa-equipment-add">
                                            <input type="text" placeholder="Tranchant…" aria-label="Nouveau type de dégâts"
                                                data-damage-type-input data-item-id="{{id}}">
                                            <button type="button" data-action="addWeaponDamageType" data-item-id="{{id}}"
                                                aria-label="Ajouter un type de dégâts" title="Ajouter un type de dégâts">+</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="aa-equipment-detail">
                                    <strong class="aa-equipment-label">Propriétés</strong>
                                    <div class="aa-equipment-options">
                                        <button type="button" aria-pressed="{{#if properties.twoHanded}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="twoHanded">Deux mains</button>
                                        <button type="button" aria-pressed="{{#if properties.finesse}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="finesse">Finesse</button>
                                        <button type="button" aria-pressed="{{#if properties.thrown}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="thrown">Lancer</button>
                                        <button type="button" aria-pressed="{{#if properties.light}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="light">Légère</button>
                                        <button type="button" aria-pressed="{{#if properties.heavy}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="heavy">Lourde</button>
                                        <button type="button" aria-pressed="{{#if properties.versatile}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="versatile">Polyvalente</button>
                                        <button type="button" aria-pressed="{{#if properties.ammunition}}true{{else}}false{{/if}}"
                                            data-action="toggleEquipmentProperty" data-item-id="{{id}}" data-property="ammunition">Munitions</button>
                                    </div>
                                </div>

                                <div class="aa-weapon-configs">
                                    {{#if properties.twoHanded}}
                                        <div class="aa-weapon-property-config">
                                            <strong>Deux mains</strong>
                                            <label class="aa-equipment-inline">
                                                <input type="checkbox" {{#if system.guardEnabled}}checked{{/if}}
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.guardEnabled">
                                                <span>Utilisable pour la Garde</span>
                                            </label>
                                        </div>
                                    {{/if}}
                                    {{#if properties.thrown}}
                                        <div class="aa-weapon-property-config">
                                            <strong>Lancer</strong>
                                            <label class="aa-equipment-inline">
                                                <span>Portée normale</span>
                                                <input type="number" value="{{system.thrown.normalRange}}"
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.thrown.normalRange">
                                                <span>m</span>
                                            </label>
                                            <label class="aa-equipment-inline">
                                                <span>Portée longue</span>
                                                <input type="number" value="{{system.thrown.longRange}}"
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.thrown.longRange">
                                                <span>m</span>
                                            </label>
                                        </div>
                                    {{/if}}
                                    {{#if properties.light}}
                                        <div class="aa-weapon-property-config">
                                            <strong>Légère</strong>
                                            <button type="button" data-action="rollWeaponBonusDamage" data-item-id="{{id}}">
                                                🎲 Dégâts d'attaque bonus
                                            </button>
                                        </div>
                                    {{/if}}
                                    {{#if properties.heavy}}
                                        <div class="aa-weapon-property-config">
                                            <strong>Lourde</strong>
                                            <label class="aa-equipment-inline">
                                                <span>FOR minimum</span>
                                                <input type="number" value="{{system.heavy.strengthRequirement}}"
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.heavy.strengthRequirement">
                                            </label>
                                        </div>
                                    {{/if}}
                                    {{#if properties.versatile}}
                                        <div class="aa-weapon-property-config">
                                            <strong>Polyvalente</strong>
                                            <label class="aa-equipment-inline">
                                                <span>Dégâts</span>
                                                <input type="text" value="{{system.versatile.damageFormula}}" placeholder="1d8"
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.versatile.damageFormula">
                                            </label>
                                            <button type="button" data-action="rollWeaponVersatileDamage" data-item-id="{{id}}"
                                                aria-label="Jet de dégâts polyvalents" title="Jet de dégâts polyvalents">🎲</button>
                                        </div>
                                    {{/if}}
                                    {{#if properties.ammunition}}
                                        <div class="aa-weapon-property-config">
                                            <strong>Munitions</strong>
                                            <label class="aa-equipment-inline">
                                                <span>Portée normale</span>
                                                <input type="number" value="{{system.ammunition.normalRange}}"
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.ammunition.normalRange">
                                                <span>m</span>
                                            </label>
                                            <label class="aa-equipment-inline">
                                                <span>Portée longue</span>
                                                <input type="number" value="{{system.ammunition.longRange}}"
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.ammunition.longRange">
                                                <span>m</span>
                                            </label>
                                            <label class="aa-equipment-inline">
                                                <input type="checkbox" {{#if system.ammunition.loading}}checked{{/if}}
                                                    data-equipment-edit data-item-id="{{id}}" data-item-field="system.ammunition.loading">
                                                <span>Chargement</span>
                                            </label>
                                        </div>
                                    {{/if}}
                                </div>
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Aucune arme équipée.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">🛡️</span>Boucliers équipés</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.shields}}
                            <div class="aa-equipment-card">
                                <div class="aa-equipment-identity">
                                    <label class="aa-equipment-field">
                                        <span>Nom</span>
                                        <input type="text" value="{{name}}"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                    </label>
                                    <label class="aa-equipment-field">
                                        <span>Classe</span>
                                        <input type="text" value="{{system.shieldClass}}"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="system.shieldClass">
                                    </label>
                                    <div class="aa-shield-controls">
                                        <label class="aa-equipment-inline">
                                            <span>DEF</span>
                                            <input type="number" value="{{system.defenseBonus}}"
                                                data-equipment-edit data-item-id="{{id}}" data-item-field="system.defenseBonus">
                                        </label>
                                        <span class="aa-equipment-stat" title="Bonus d'Expertise">Exp. {{expertiseBonus}}</span>
                                        <label class="aa-equipment-inline">
                                            <input type="checkbox" {{#if system.guardEnabled}}checked{{/if}}
                                                data-equipment-edit data-item-id="{{id}}" data-item-field="system.guardEnabled">
                                            <span>Garde</span>
                                        </label>
                                        <div class="aa-equipment-actions">
                                            <button type="button" data-action="toggleEquipment" data-item-id="{{id}}"
                                                aria-label="Déséquiper" title="Déséquiper">↓</button>
                                            <button type="button" data-action="deleteEquipment" data-item-id="{{id}}"
                                                aria-label="Supprimer" title="Supprimer">×</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Aucun bouclier équipé.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">🥋</span>Protections équipées</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.protections}}
                            <div class="aa-equipment-card">
                                <div class="aa-equipment-identity">
                                    <label class="aa-equipment-field">
                                        <span>Nom</span>
                                        <input type="text" value="{{name}}"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                    </label>
                                    <label class="aa-equipment-field">
                                        <span>Classe</span>
                                        <input type="text" value="{{system.armorClass}}" placeholder="Plaque"
                                            data-equipment-edit data-item-id="{{id}}" data-item-field="system.armorClass">
                                    </label>
                                    <div class="aa-protection-controls">
                                        <label class="aa-equipment-inline">
                                            <span>DEF</span>
                                            <input type="number" value="{{system.defenseBonus}}"
                                                data-equipment-edit data-item-id="{{id}}" data-item-field="system.defenseBonus">
                                        </label>
                                        <div class="aa-equipment-actions">
                                            <button type="button" data-action="toggleEquipment" data-item-id="{{id}}"
                                                aria-label="Déséquiper" title="Déséquiper">↓</button>
                                            <button type="button" data-action="deleteEquipment" data-item-id="{{id}}"
                                                aria-label="Supprimer" title="Supprimer">×</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="aa-equipment-detail">
                                    <strong class="aa-equipment-label">Zones</strong>
                                    <div class="aa-equipment-options">
                                        <button type="button" aria-pressed="{{#if zones.head}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="head">Tête</button>
                                        <button type="button" aria-pressed="{{#if zones.torso}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="torso">Torse</button>
                                        <button type="button" aria-pressed="{{#if zones.arms}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="arms">Bras</button>
                                        <button type="button" aria-pressed="{{#if zones.legs}}true{{else}}false{{/if}}"
                                            data-action="toggleProtectionZone" data-item-id="{{id}}" data-zone="legs">Jambes</button>
                                    </div>
                                </div>

                                <div class="aa-equipment-detail">
                                    <strong class="aa-equipment-label">Réductions</strong>
                                    <div class="aa-equipment-options">
                                        {{#each damageReductions}}
                                            <span class="aa-equipment-pill">
                                                <span>{{type}}</span>
                                                <input type="number" value="{{value}}" min="0" aria-label="Réduction contre {{type}}"
                                                    data-equipment-edit data-item-id="{{../id}}" data-item-field="system.damageReductions.{{type}}">
                                                <button type="button" data-action="removeProtectionReduction"
                                                    data-item-id="{{../id}}" data-damage-type="{{type}}"
                                                    aria-label="Retirer la réduction contre {{type}}" title="Retirer la réduction">×</button>
                                            </span>
                                        {{/each}}
                                        <div class="aa-equipment-add">
                                            <input type="text" placeholder="Tranchant…" aria-label="Type de dégâts à réduire"
                                                data-reduction-type-input data-item-id="{{id}}">
                                            <input type="number" min="0" placeholder="0" aria-label="Valeur de la réduction"
                                                data-reduction-value-input data-item-id="{{id}}">
                                            <button type="button" data-action="addProtectionReduction" data-item-id="{{id}}"
                                                aria-label="Ajouter une réduction" title="Ajouter une réduction">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Aucune protection équipée.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">💍</span>Accessoires équipés</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.accessories}}
                            <div class="aa-equipment-row">
                                <input type="text" value="{{name}}" aria-label="Nom de l'accessoire"
                                    data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                <div class="aa-equipment-actions">
                                    <button type="button" data-action="toggleEquipment" data-item-id="{{id}}">Déséquiper</button>
                                    <button type="button" data-action="deleteEquipment" data-item-id="{{id}}"
                                        aria-label="Supprimer" title="Supprimer">×</button>
                                </div>
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Aucun accessoire équipé.</p>
                        {{/each}}
                    </div>
                </section>

                <section class="aa-equipment-section">
                    <h3><span class="aa-heading-icon" aria-hidden="true">📦</span>Inventaire</h3>

                    <div class="aa-equipment-list">
                        {{#each equipment.inventory}}
                            <div class="aa-equipment-row">
                                <input type="text" value="{{name}}" aria-label="Nom de l'objet"
                                    data-equipment-edit data-item-id="{{id}}" data-item-field="name">
                                <span class="aa-equipment-stat aa-item-type">{{type}}</span>
                                <div class="aa-equipment-actions">
                                    <button type="button" data-action="toggleEquipment" data-item-id="{{id}}">Équiper</button>
                                    <button type="button" data-action="deleteEquipment" data-item-id="{{id}}"
                                        aria-label="Supprimer" title="Supprimer">×</button>
                                </div>
                            </div>
                        {{else}}
                            <p class="aa-empty-equipment">Inventaire vide.</p>
                        {{/each}}
                    </div>
                </section>
            </div>

        </section>


        <section
            class="tab"
            data-group="sheet"
            data-tab="arcanology"
        >
            <div class="aa-tab-placeholder">
                <h2><span class="aa-heading-icon" aria-hidden="true">🔮</span>Arcanologie</h2>
                <p>À construire.</p>
            </div>
        </section>


        <section
            class="tab"
            data-group="sheet"
            data-tab="information"
        >
            <div class="aa-tab-placeholder">
                <h2><span class="aa-heading-icon" aria-hidden="true">📜</span>Informations</h2>
                <p>À construire.</p>
            </div>
        </section>


        <section
            class="tab"
            data-group="sheet"
            data-tab="options"
        >
            <div class="aa-tab-placeholder">
                <h2><span class="aa-heading-icon" aria-hidden="true">⚙️</span>Options</h2>
                <p>À construire.</p>
            </div>
        </section>

    </div>

</div>
