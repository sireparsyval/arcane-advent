<div class="aa-storage-body">
    {{#if looseItem}}
    <header class="aa-storage-header aa-ground-item-header">
        <img src="{{looseItem.img}}" alt="{{looseItem.name}}">
        <div><strong>{{looseItem.name}}</strong><span>× {{looseItem.quantity}}</span></div>
    </header>
    <button type="button" data-action="quickInventory" data-inventory-action="transfer" data-item-id="{{looseItem.id}}" {{#unless canTransfer}}disabled{{/unless}}><i class="fa-solid fa-right-left"></i> Transférer</button>
    {{#if looseItem.isPurse}}<button type="button" data-action="purseActions" data-item-id="{{looseItem.id}}" {{#unless canTransfer}}disabled{{/unless}}><i class="fa-solid fa-coins"></i> Luqa</button>{{/if}}
    {{else}}
    <header class="aa-storage-header">
        <img src="{{actor.img}}" alt="{{actor.name}}">
        <div>
            <strong>{{#if ground}}Dépôt au sol{{else}}Stockage permanent{{/if}}</strong>
            {{#if isGM}}
                <label>Nom <input data-storage-field="name" value="{{actor.name}}"></label>
                <label>Image <input data-storage-field="img" value="{{actor.img}}"></label>
                <label><input type="checkbox" data-storage-field="system.locked" {{checked locked}}> Verrouiller les échanges des joueurs</label>
                <label><input type="checkbox" data-storage-field="system.fixedOnScene" {{checked fixedOnScene}}> Fixe sur scène (contenant non transportable)</label>
            {{else}}
                <h2>{{actor.name}}</h2>
                {{#if locked}}<p>Stockage verrouillé.</p>{{/if}}
            {{/if}}
        </div>
    </header>
    <div class="aa-storage-toolbar">
        {{#if canTransfer}}
            <button type="button" data-action="transfer"><i class="fa-solid fa-right-left"></i> Transférer…</button>
            <button type="button" data-action="dropGround"><i class="fa-solid fa-arrow-down-to-line" aria-hidden="true"></i> Déposer au sol…</button>
        {{/if}}
        {{#if canPlace}}<button type="button" data-action="place">Placer sur la scène</button>{{/if}}
    </div>
    <p>Ciblez un personnage ou un stockage sur la scène, puis cliquez sur « Transférer ».</p>
    <div class="aa-storage-items">
        {{#each rows}}
            <div class="aa-storage-row" style="--aa-inventory-depth: {{depth}}">
                <span>{{#if container}}📦 {{/if}}{{name}}</span>
                <span>× {{quantity}}</span><span>{{weight}} kg</span>
                {{#if @root.canTransfer}}
                    {{#if isPurse}}<button type="button" data-action="purseActions" data-item-id="{{id}}" title="Opérations sur les Luqa" aria-label="Transférer ou déposer des Luqa"><i class="fa-solid fa-coins" aria-hidden="true"></i></button>{{/if}}
                    <button type="button" data-action="quickInventory" data-inventory-action="transfer" data-item-id="{{id}}"
                        title="Transférer" aria-label="Transférer {{name}}"><i class="fa-solid fa-right-left" aria-hidden="true"></i></button>
                    <button type="button" data-action="quickInventory" data-inventory-action="drop" data-item-id="{{id}}"
                        title="Déposer au sol" aria-label="Déposer {{name}} au sol"><i class="fa-solid fa-arrow-down-to-line" aria-hidden="true"></i></button>
                {{/if}}
                {{#if @root.isGM}}
                    <button type="button" data-action="editItem" data-item-id="{{id}}" title="Modifier {{name}}" aria-label="Modifier {{name}}">⚙</button>
                {{/if}}
            </div>
        {{else}}<p>{{#if ground}}Ce dépôt est vide.{{else}}Ce stockage est vide.{{/if}}</p>{{/each}}
    </div>
    <footer class="aa-storage-toolbar">
        <strong>Total · {{totalWeight}} kg</strong>
        {{#if isGM}}
            <button type="button" data-action="addItem" data-type="object">+ Objet</button>
            <button type="button" data-action="addItem" data-type="container">+ Contenant</button>
            <button type="button" data-action="addItem" data-type="purse">+ Bourse</button>
        {{/if}}
    </footer>
    {{/if}}
</div>
